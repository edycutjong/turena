# ============================================================
# FRONTEND — Vercel environment variables
# ============================================================

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — server-side API routes only, NEVER exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Contract addresses (populated after running: cd contracts && npx hardhat run scripts/deploy.ts)
NEXT_PUBLIC_TURING_AGENT_ADDRESS=
NEXT_PUBLIC_ESCROW_ADDRESS=

# Backend URL — server-side only, never exposed to the browser
# Local: http://localhost:8000 | Production: your Railway URL
BACKEND_URL=http://localhost:8000

# Demo mode — enables /api/agent/trade-loop and /api/agent/mock-outcome endpoints
# NEVER true in production
DEMO_MODE=false
