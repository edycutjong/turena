# Supabase (Get keys from https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# DeepSeek R1 (backend — never expose to client)
# Get key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Bybit (backend)
# Get keys from https://testnet.bybit.com/app/user/api-management
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# Mantle
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
# Export private key from MetaMask or your Web3 wallet (use a throwaway dev wallet!)
DEPLOYER_PRIVATE_KEY=

# Contract addresses (populated after deploy)
TURING_AGENT_ADDRESS=
ESCROW_ADDRESS=

# Demo recording only — NEVER true in production
DEMO_MODE=false
