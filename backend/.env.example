# ============================================================
# BACKEND — Railway environment variables
# ============================================================

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
# SUPABASE_URL is the same value as NEXT_PUBLIC_SUPABASE_URL in the frontend
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Database connection — used by asyncpg to connect directly to Supabase PostgreSQL
# Option A (recommended): set DATABASE_URL explicitly
#   Format: postgresql://postgres.<project-id>:<DB_PASSWORD>@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres
#   ⚠️  Use the DATABASE PASSWORD, NOT the service role JWT key
#   Get it from: Supabase Dashboard → Project Settings → Database → Database Password
DATABASE_URL=

# Option B: leave DATABASE_URL blank and set these two instead
#   SUPABASE_DB_PASSWORD is the actual database password (same place as above)
SUPABASE_DB_PASSWORD=

# DeepSeek R1 — never expose to client
# Get key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Bybit (backend)
# Get keys from https://testnet.bybit.com/app/user/api-management
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# Mantle
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
# Export private key from MetaMask or your Web3 wallet (use a throwaway dev wallet!)
DEPLOYER_PRIVATE_KEY=

# Contract addresses (populated after running: cd contracts && npx hardhat run scripts/deploy.ts)
TURING_AGENT_ADDRESS=
ESCROW_ADDRESS=

# Trade loop
AUTO_CYCLE=false

# Demo recording only — NEVER true in production
DEMO_MODE=false
